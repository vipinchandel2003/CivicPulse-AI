    "/api/v1/issues": {
      "post": {
        "tags": [
          "Issues"
        ],
        "summary": "Submit Issue",
        "description": "Fast Sync Submit (< 400 ms):\n1. Validate single-use nonce\n2. Check GPS accuracy (<= 50m)\n3. Look up Ward via ST_Covers\n4. Check for duplicate open issue within 25m\n   - If duplicate found: merge, increment merged_count, register upvote, emit event\n   - If new: create CivicIssue with ticket_code, emit RECEIVED event\n5. Save IssueReport & IssueMedia\n6. Return immediately with status & ticket_code",
        "operationId": "submit_issue_api_v1_issues_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueSubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
