    "/api/v1/issues/{issue_id}/resolve": {
      "post": {
        "tags": [
          "Verification & Review"
        ],
        "summary": "Resolve Issue",
        "description": "Superpower 1: Proof-of-Work Lock:\n1. Check single-use server nonce (60s TTL).\n2. Check is_mock_location (rejected if Android native mock location flag is true).\n3. Check GPS accuracy (<= 20m required for resolve).\n4. Check Geofence: ST_DWithin(issue.location, resolver_point, 30m).\n5. Save AFTER image media & run Verification Agent (CLIP + YOLO target absence).\n6. Transition to RESOLVED or PENDING_REVIEW with immutable event log.",
        "operationId": "resolve_issue_api_v1_issues__issue_id__resolve_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "issue_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Issue Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveIssueRequest"
              }
            }
