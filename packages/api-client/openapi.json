    "/api/v1/issues/nearby": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "Get Nearby Issues",
        "description": "Nearby Issues Query for Citizen PWA map and list:\nReturns open and recent issues within radius_metres using ST_DWithin (Geography).",
        "operationId": "get_nearby_issues_api_v1_issues_nearby_get",
        "parameters": [
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "Longitude"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "Latitude"
            }
          },
          {
            "name": "radius_metres",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 5000.0,
              "minimum": 10.0,
              "default": 500.0,
              "title": "Radius Metres"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NearbyIssueItem"
                  },
                  "title": "Response Get Nearby Issues Api V1 Issues Nearby Get"
                }
              }
            }
          },
