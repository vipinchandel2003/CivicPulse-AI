# CivicPulse AI Environment Configuration
PROJECT_NAME="CivicPulse AI API"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Connection (PostgreSQL with PostGIS & pgvector)
DATABASE_URL="postgresql://civicpulse:civicpulse_secret@localhost:5432/civicpulse"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# MinIO / Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="civicpulse-media"
MINIO_SECURE=False

# JWT Security
SECRET_KEY="super_secret_jwt_signing_key_for_dev_change_in_production_32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
